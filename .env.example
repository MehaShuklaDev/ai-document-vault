# ---- AI providers -------------------------------------------------------------
# LLM_PROVIDER=auto (default) picks the first available, in this order:
#   1. OPENAI_API_KEY set       → openai      (GPT-4o-mini by default; embeddings: text-embedding-3-small)
#   2. ANTHROPIC_API_KEY set    → anthropic   (Claude Sonnet 4 by default)
#   3. `claude` CLI logged in   → claude-cli  (no key: uses your Claude Code login; dev/demo only, ~3-8 s per call)
#   4. none of the above        → the app refuses to start with a clear error (it never silently uses fake data)
# Set an explicit value to force one: openai | anthropic | claude-cli | fake (fake = offline deterministic, tests/CI only)
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto             # auto: openai if OPENAI_API_KEY, else local hashed embeddings (hybrid full-text search still retrieves)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=                       # override main model, e.g. gpt-4o / claude-sonnet-4-20250514 / opus (claude-cli)
# LLM_FAST_MODEL=                  # cheap model for condense / follow-ups / reranking
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536        # must match the vector column; change requires a migration
# CLAUDE_CLI_PATH=claude           # claude-cli: binary name on PATH or an absolute path

# ---- infra (defaults match docker-compose) -----------------------------------
DATABASE_URL=postgresql+asyncpg://vault:vault@localhost:5433/vault
REDIS_URL=redis://localhost:6380/0
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/blobs
# STORAGE_BACKEND=s3
# S3_BUCKET=my-bucket
# S3_ENDPOINT_URL=http://minio:9000

# ---- behaviour ----------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=8
CONTEXT_TOKEN_BUDGET=3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
QUOTA_USD_PER_USER_PER_DAY=0          # rolling-24h spend cap per user on AI endpoints (0 = off); 429 when exhausted
QUOTA_TOKENS_PER_USER_PER_DAY=0       # same, in tokens

# ---- retrieval quality (feature flags) ------------------------------------------
RERANK_ENABLED=false               # second-stage reranking of the top-20 fused candidates
RERANK_PROVIDER=lexical            # cross_encoder (pip install sentence-transformers) | llm (fast model) | lexical
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
RERANK_WEIGHT=0.6                  # blend: w*rerank + (1-w)*rrf
STRUCTURED_EXTRACTION_ENABLED=true # category-specific field extraction as a 5th pipeline stage
